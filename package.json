{
  "name": "cache-warmup",
  "version": "2.0.0",
  "description": "Short, interactive lessons to refresh software engineering fundamentals, with an optional AI mock interviewer.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && node server/index.mjs --open",
    "dev": "vite",
    "build": "vite build",
    "serve": "node server/index.mjs",
    "providers": "node server/index.mjs --list",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc -b && vitest run"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
